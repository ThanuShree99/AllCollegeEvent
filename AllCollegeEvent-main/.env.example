# GEMINI_API_KEY: Required for Gemini AI API calls (AI Fest Mate concierge
# and itinerary generation). Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The public URL this app is hosted at (used for self-referential
# links / OAuth callbacks if you add auth later). Optional for local dev.
APP_URL="http://localhost:3000"
